+          bindings: [
+            {
+              type: "vpc_service",
+              name: service.LogicalId,
+              serviceId: service.serviceId,
+            },
+          ],
+        });
+      }
+
+      return {
+        fetch: (request) =>
+          Effect.gen(function* () {
+            const env = yield* WorkerEnvironment;
+            const binding = env[service.LogicalId];
+
+            if (
+              typeof binding !== "object" ||
+              binding === null ||
+              !("fetch" in binding)
+            ) {
+              return yield* new HttpClientError.HttpClientError({
