{
  "name": "opencode-event-bridge",
  "private": true,
  "type": "module",
  "module": "alchemy.run.ts",
  "scripts": {
    "prepare": "lefthook install || true && effect-language-service patch",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
