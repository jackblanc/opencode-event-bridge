{
  "name": "opencode-event-bridge",
  "private": true,
  "type": "module",
  "module": "alchemy.run.ts",
  "scripts": {
    "prepare": "lefthook install || true && effect-language-service patch",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:fix": "oxfmt --write .",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format && pnpm run knip"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-beta.66",
    "alchemy": "2.0.0-beta.39",
    "effect": "4.0.0-beta.66"
  },
  "devDependencies": {
    "@effect/language-service": "^0.86.1",
    "@types/node": "^25.7.0",
    "knip": "^6.13.1",
    "lefthook": "^2.1.6",
    "oxfmt": "^0.49.0",
    "oxlint": "^1.64.0",
    "oxlint-tsgolint": "^0.22.1",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@10.23.0",
  "pnpm": {
    "patchedDependencies": {
      "@distilled.cloud/cloudflare@0.20.2": "patches/@distilled.cloud%2Fcloudflare@0.20.2.patch"
    }
  }
}
