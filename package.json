    "effect": "4.0.0-beta.66"
  },
  "devDependencies": {
    "@effect/language-service": "^0.86.1",
    "@types/node": "^25.7.0",
    "knip": "^6.13.1",
    "lefthook": "^2.1.6",
    "oxfmt": "^0.49.0",
    "oxlint": "^1.64.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@distilled.cloud/cloudflare-runtime": "0.4.1"
  },
  "patchedDependencies": {
    "@distilled.cloud/cloudflare@0.20.1": "patches/@distilled.cloud%2Fcloudflare@0.20.1.patch"
